# Backend URL is server-side only. Never expose internal URLs with NEXT_PUBLIC_*.
MEDBOT_API_URL=http://localhost:8000

# `dev` uses one predefined backend development token on the server.
# `oidc` enables Keycloak authorization-code + PKCE login.
MEDBOT_AUTH_MODE=oidc
MEDBOT_DEV_TOKEN=dev-token-org-a

MEDBOT_OIDC_ISSUER=http://localhost:8081/realms/medbot
MEDBOT_OIDC_CLIENT_ID=medbot-ui
MEDBOT_OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Use at least 32 random bytes outside local development.
MEDBOT_SESSION_SECRET=replace-with-a-random-local-development-secret-at-least-32-characters
MEDBOT_SESSION_SECURE=false
